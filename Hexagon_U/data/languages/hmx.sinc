with slot: iclass=0b1010 {
	:"acc=mxshl(acc, #16)" is imm_16_27=0b011011100000 & imm_0_13=0x17 {
		HMX_mxshl_16();
	}
	
	:"mxclracc" is imm_16_27=0b011011100000 & imm_0_13=0x11 {
		HMX_mxclracc();
	}
	
	:"mxclracc.hf" is imm_16_27=0b011011100000 & imm_0_13=0x13 {
		HMX_mxclracc_hf();
	}
}


