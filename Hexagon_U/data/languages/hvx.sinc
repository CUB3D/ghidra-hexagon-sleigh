    :"if("Qs4_5_6_pred") vscatter(" S5 "," M1_13 "," VT5 ".h).h=" VD5 is imm_21_27=0b1111100 & S5 & M1_13 & VT5 & imm_7=1 & Qs4_5_6_pred & VD5 {
