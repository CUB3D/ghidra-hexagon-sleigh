# Multiply with piecewise add/sub from 64-bit scalar
with slot: iclass=0b0001 {
    :VD5".h = vmpa("VD5_dup".h,"VT5".h,"VS5_pair".h):sat" is imm_21_27=0b1001100 & VS5_pair & imm_13=1 & VT5 & imm_5_7=0b100 & VD5 & VD5_dup {
        VD5 = HVX_mpa_sat(VD5_dup, VT5, VS5_pair);
    }
    :VD5".h = vmpa("VD5_dup".h,"VT5".uh,"VS5_pair".uh):sat" is imm_21_27=0b1001100 & VS5_pair & imm_13=1 & VT5 & imm_5_7=0b101 & VD5 & VD5_dup {
        VD5 = HVX_mpa_sat(VD5_dup, VT5, VS5_pair);
    }
    :VD5".h = vmps("VD5_dup".h,"VT5".uh,"VS5_pair".uh):sat" is imm_21_27=0b1001100 & VS5_pair & imm_13=1 & VT5 & imm_5_7=0b110 & VD5 & VD5_dup {
        VD5 = HVX_mps_sat(VD5_dup, VT5, VS5_pair);
    }
    
    # (v85)
	:VD5".h = vmpa("VD5_dup".h,"VT5".uh,"VS5_pair".uh)" is imm_21_27=0b1001111 & VS5_pair & imm_13=1 & VT5 & imm_5_7=0b011 & VD5 & VD5_dup {
        VD5 = HVX_mpa(VD5_dup, VT5, VS5_pair);
    }
    # (v85)
    :VD5".h = vmps("VD5_dup".h,"VT5".uh,"VS5_pair".uh)" is imm_21_27=0b1001111 & VS5_pair & imm_13=1 & VT5 & imm_5_7=0b100 & VD5 & VD5_dup {
        VD5 = HVX_mps(VD5_dup, VT5, VS5_pair);
    }
    # (v85)
    :VD5".uh = vmpa("VD5_dup".uh,"VT5".uh,"VS5_pair".uh)" is imm_21_27=0b1001111 & VS5_pair & imm_13=1 & VT5 & imm_5_7=0b000 & VD5 & VD5_dup {
        VD5 = HVX_mpa(VD5_dup, VT5, VS5_pair);
    }
    
}

# Multiply - add
with slot: iclass=0b0001 {
    :VD5_pair".h = vmpa("VT5_pair".ub,"S5".b)" is imm_21_27=0b1001001 & S5 & imm_13=0 & VT5_pair & imm_5_7=0b110 & VD5_pair {
        VD5_pair = HVX_mpa(VT5_pair, S5);
    }
	:VD5_pair".w = vmpa("VT5_pair".h,"S5".b)" is imm_21_27=0b1001001 & S5 & imm_13=0 & VT5_pair & imm_5_7=0b111 & VD5_pair {
        VD5_pair = HVX_mpa(VT5_pair, S5);
    }

	:VD5_pair".h += vmpa("VT5_pair".ub,"S5".b)" is imm_21_27=0b1001001 & S5 & imm_13=1 & VT5_pair & imm_5_7=0b110 & VD5_pair {
        VD5_pair = HVX_mpa_acc(VD5_pair, VT5_pair, S5);
    }
	:VD5_pair".w += vmpa("VT5_pair".h,"S5".b)" is imm_21_27=0b1001001 & S5 & imm_13=1 & VT5_pair & imm_5_7=0b111 & VD5_pair {
        VD5_pair = HVX_mpa_acc(VD5_pair, VT5_pair, S5);
    }

	:VD5_pair".h = vmpa("VT5_pair".ub,"S5".ub)" is imm_21_27=0b1001011 & S5 & imm_13=0 & VT5_pair & imm_5_7=0b011 & VD5_pair {
        VD5_pair = HVX_mpa(VT5_pair, S5);
    }
	:VD5_pair".w = vmpa("VT5_pair".uh,"S5".b)" is imm_21_27=0b1001100 & S5 & imm_13=0 & VT5_pair & imm_5_7=0b101 & VD5_pair {
        VD5_pair = HVX_mpa(VT5_pair, S5);
    }

	:VD5_pair".w += vmpa("VT5_pair".uh,"S5".b)" is imm_21_27=0b1001100 & S5 & imm_13=1 & VT5_pair & imm_5_7=0b010 & VD5_pair {
        VD5_pair = HVX_mpa_acc(VD5_pair, VT5_pair, S5);
    }
	:VD5_pair".h += vmpa("VT5_pair".ub,"S5".ub)" is imm_21_27=0b1001101 & S5 & imm_13=1 & VT5_pair & imm_5_7=0b100 & VD5_pair {
        VD5_pair = HVX_mpa_acc(VD5_pair, VT5_pair, S5);
    }

	:VD5_pair".h = vmpa("VT5_pair".ub,"VS5_pair".b)" is imm_21_27=0b1100001 & VS5_pair & imm_13=0 & VT5_pair & imm_5_7=0b011 & VD5_pair {
        VD5_pair = HVX_mpa(VT5_pair, VS5_pair);
    }
	:VD5_pair".h = vmpa("VT5_pair".ub,"VS5_pair".ub)" is imm_21_27=0b1100111 & VS5_pair & imm_13=0 & VT5_pair & imm_5_7=0b111 & VD5_pair {
        VD5_pair = HVX_mpa(VT5_pair, VS5_pair);
    }
    
    # (v85)
    :VD5_pair".uw = vmpa("VD5_pair_dup".uh,"VT5".uh, "VS5".w)" is imm_21_27=0b1010101 & VS5 & imm_13=1 & VT5 & imm_5_7=0b110 & VD5_pair & VD5_pair_dup {
        VD5_pair = HVX_mpa(VD5_pair_dup, VT5, VS5);
    }
    # (v85)
    :VD5_pair".w = vmpa("VD5_pair_dup".h,"VT5".uh, "VS5".w)" is imm_21_27=0b1010101 & VS5 & imm_13=1 & VT5 & imm_5_7=0b101 & VD5_pair & VD5_pair_dup {
        VD5_pair = HVX_mpa(VD5_pair_dup, VT5, VS5);
    }
}

# Multiply vector by scalar
with slot: iclass=0b0001 {
    :VD5_pair".h = vmpy("VT5".ub,"S5".b)" is imm_21_27=0b1001001 & S5 & imm_13=0 & VT5 & imm_5_7=0b101 & VD5_pair {
        VD5_pair = HVX_mpy(VT5, S5);
    }

	:VD5_pair".h += vmpy("VT5".ub,"S5".b)" is imm_21_27=0b1001001 & S5 & imm_13=1 & VT5 & imm_5_7=0b101 & VD5_pair {
        VD5_pair = HVX_mpy_acc(VD5_pair, VT5, S5);
    }

	:VD5_pair".w = vmpy("VT5".h,"S5".h)" is imm_21_27=0b1001010 & S5 & imm_13=0 & VT5 & imm_5_7=0b000 & VD5_pair {
        VD5_pair = HVX_mpy(VT5, S5);
    }
	:VD5_pair".uw = vmpy("VT5".uh,"S5".uh)" is imm_21_27=0b1001010 & S5 & imm_13=0 & VT5 & imm_5_7=0b011 & VD5_pair {
        VD5_pair = HVX_mpy(VT5, S5);
    }

	:VD5_pair".w += vmpy("VT5".h,"S5".h):sat" is imm_21_27=0b1001010 & S5 & imm_13=1 & VT5 & imm_5_7=0b000 & VD5_pair {
        VD5_pair = HVX_mpy_acc_sat(VD5_pair, VT5, S5);
    }
	:VD5_pair".uw += vmpy("VT5".uh,"S5".uh)" is imm_21_27=0b1001010 & S5 & imm_13=1 & VT5 & imm_5_7=0b001 & VD5_pair {
        VD5_pair = HVX_mpy_acc(VD5_pair, VT5, S5);
    }
	:VD5_pair".uh += vmpy("VT5_pair".ub,"VS5_pair".ub)" is imm_21_27=0b1001100 & VS5_pair & imm_13=1 & VT5_pair & imm_5_7=0b000 & VD5_pair {
        VD5_pair = HVX_mpy_acc(VD5_pair, VT5_pair, VS5_pair);
    }
	:VD5_pair".w += vmpy("VT5".h,"S5".h)" is imm_21_27=0b1001101 & S5 & imm_13=1 & VT5 & imm_5_7=0b110 & VD5_pair {
        VD5_pair = HVX_mpy_acc(VD5_pair, VT5, S5);
    }

	:VD5_pair".uh = vmpy("VT5".ub,"S5".ub)" is imm_21_27=0b1001110 & S5 & imm_13=0 & VT5 & imm_5_7=0b000 & VD5_pair {
        VD5_pair = HVX_mpy(VT5, S5);
    }
    
    # (v85)
    :VD5_pair".w = vmpy("VT5_pair".h,"VS5_pair".uh)" is imm_21_27=0b1010100 & VS5_pair & imm_13=1 & VT5_pair & imm_5_7=0b100 & VD5_pair {
        VD5_pair = HVX_mpy(VT5_pair, VS5_pair);
    }
    # (v85)
    :VD5_pair".w += vmpy("VT5_pair".h,"VS5_pair".uh)" is imm_21_27=0b1010100 & VS5_pair & imm_13=1 & VT5_pair & imm_5_7=0b101 & VD5_pair {
        VD5_pair = HVX_mpy_acc(VD5_pair, VT5_pair, VS5_pair);
    }
}

# Multiply vector by vector
with slot: iclass=0b0001 {
    :VD5_pair".h = vmpy("VT5".b,"VS5".b)" is imm_21_27=0b1100000 & VS5 & imm_13=0 & VT5 & imm_5_7=0b100 & VD5_pair {
        VD5_pair = HVX_mpy(VT5, VS5);
    }
    :VD5_pair".h += vmpy("VT5".b,"VS5".b)" is imm_21_27=0b1100000 & VS5 & imm_13=1 & VT5 & imm_5_7=0b100 & VD5_pair {
        VD5_pair = HVX_mpy_acc(VD5_pair, VT5, VS5);
    }
    :VD5_pair".uh = vmpy("VT5".ub,"VS5".ub)" is imm_21_27=0b1100000 & VS5 & imm_13=0 & VT5 & imm_5_7=0b101 & VD5_pair {
        VD5_pair = HVX_mpy(VT5, VS5);
    }
    :VD5_pair".uh += vmpy("VT5".ub,"VS5".ub)" is imm_21_27=0b1100000 & VS5 & imm_13=1 & VT5 & imm_5_7=0b101 & VD5_pair {
        VD5_pair = HVX_mpy_acc(VD5_pair, VT5, VS5);
    }
    :VD5_pair".h = vmpy("VT5".ub,"VS5".b)" is imm_21_27=0b1100000 & VS5 & imm_13=0 & VT5 & imm_5_7=0b110 & VD5_pair {
        VD5_pair = HVX_mpy(VT5, VS5);
    }
    :VD5_pair".h += vmpy("VT5".ub,"VS5".b)" is imm_21_27=0b1100000 & VS5 & imm_13=1 & VT5 & imm_5_7=0b110 & VD5_pair {
        VD5_pair = HVX_mpy_acc(VD5_pair, VT5, VS5);
    }
    :VD5_pair".w = vmpy("VT5_pair".h,"VS5_pair".h)" is imm_21_27=0b1100000 & VS5_pair & imm_13=0 & VT5_pair & imm_5_7=0b111 & VD5_pair {
        VD5_pair = HVX_mpy(VT5_pair, VS5_pair);
    }
    :VD5_pair".w += vmpy("VT5_pair".h,"VS5_pair".h)" is imm_21_27=0b1100000 & VS5_pair & imm_13=1 & VT5_pair & imm_5_7=0b111 & VD5_pair {
        VD5_pair = HVX_mpy_acc(VD5_pair, VT5_pair, VS5_pair);
    }
    :VD5_pair".uw = vmpy("VT5_pair".uh,"VS5_pair".uh)" is imm_21_27=0b1100001 & VS5_pair & imm_13=0 & VT5_pair & imm_5_7=0b000 & VD5_pair {
        VD5_pair = HVX_mpy(VT5_pair, VS5_pair);
    }
    :VD5_pair".uw += vmpy("VT5".uh,"VS5".uh)" is imm_21_27=0b1100001 & VS5 & imm_13=1 & VT5 & imm_5_7=0b000 & VD5_pair {
        VD5_pair = HVX_mpy_acc(VD5_pair, VT5, VS5);
    }
    :VD5_pair".w = vmpy("VT5_pair".h,"VS5_pair".uh)" is imm_21_27=0b1100001 & VS5_pair & imm_13=0 & VT5_pair & imm_5_7=0b010 & VD5_pair {
        VD5_pair = HVX_mpy(VT5_pair, VS5_pair);
    }
    :VD5_pair".w += vmpy("VT5_pair".h,"VS5_pair".uh)" is imm_21_27=0b1100001 & VS5_pair & imm_13=1 & VT5_pair & imm_5_7=0b001 & VD5_pair {
        VD5_pair = HVX_mpy_acc(VD5_pair, VT5_pair, VS5_pair);
    }
}

# Integer multiply - vector by vector
with slot: iclass=0b0001 {
    :VD5".h = vmpyi("VT5".h,"VS5".h)" is imm_21_27=0b1100001 & VS5 & imm_13=0 & VT5 & imm_5_7=0b100 & VD5 {
        VD5 = HVX_mpyi(VT5, VS5);
    }
    :VD5".h += vmpyi("VT5".h,"VS5".h)" is imm_21_27=0b1100001 & VS5 & imm_13=1 & VT5 & imm_5_7=0b100 & VD5 {
        VD5 = HVX_mpyi_acc(VD5, VT5, VS5);
    }
}

# Integer multiply 32x16
with slot: iclass=0b0001 {
    :VD5".w += vmpyie("VT5".w,"VS5".uh)" is imm_21_27=0b1100001 & VS5 & imm_13=1 & VT5 & imm_5_7=0b101 & VD5 {
        VD5 = HVX_mpyie_acc(VD5, VT5, VS5);
    }
    :VD5".w += vmpyie("VT5".w,"VS5".h)" is imm_21_27=0b1100010 & VS5 & imm_13=1 & VT5 & imm_5_7=0b000 & VD5 {
        VD5 = HVX_mpyie_acc(VD5, VT5, VS5);
    } 
    
    :VD5".w += vmpyie("VT5".w,"VS5".uh)" is imm_21_27=0b1111110 & VS5 & imm_13=0 & VT5 & imm_5_7=0b000 & VD5 {
        VD5 = HVX_mpyie_acc(VD5, VT5, VS5);
    } 
    :VD5".w += vmpyio("VT5".w,"VS5".h)" is imm_21_27=0b1111110 & VS5 & imm_13=0 & VT5 & imm_5_7=0b001 & VD5 {
        VD5 = HVX_mpyio_acc(VD5, VT5, VS5);
    } 
}

# Integer multiply accumulate even/odd
with slot: iclass=0b0001 {
    :VD5".w += vmpyi("VT5".w,"S5".h)" is imm_21_27=0b1001010 & S5 & imm_13=1 & VT5 & imm_5_7=0b011 & VD5 {
        VD5 = HVX_mpyi_acc(VD5, VT5, S5);
    }    
    :VD5".w = vmpyi("VT5".w,"S5".h)" is imm_21_27=0b1001100 & S5 & imm_13=0 & VT5 & imm_5_7=0b111 & VD5 {
        VD5 = HVX_mpyi(VT5, S5);
    }    
}

# Floating point multiply - half precision
with slot: iclass=0b0001 {
    :VD5".qf16 = vmpy("VT5".qf16,"VS5".qf16)" is imm_21_27=0b1111111 & VS5 & imm_13=1 & VT5 & imm_5_7=0b011 & VD5 {
        VD5 = HVX_mpy(VT5, VS5);
    }       
    # (v79)
    :VD5".qf16 = vmpy("VT5".hf,"VS5".hf)" is imm_21_27=0b1111111 & VS5 & imm_13=1 & VT5 & imm_5_7=0b100 & VD5 {
        VD5 = HVX_mpy(VT5, VS5);
    }       
    # (v79)
    :VD5".qf16 = vmpy("VT5".qf16,"VS5".hf)" is imm_21_27=0b1111111 & VS5 & imm_13=1 & VT5 & imm_5_7=0b101 & VD5 {
        VD5 = HVX_mpy(VT5, VS5);
    }   
    :VD5".qf16 = vmpy("VT5".qf16,"S5".hf)" is imm_21_27=0b1010000 & S5 & imm_13=1 & VT5 & imm_5_7=0b010 & VD5 {
        VD5 = HVX_mpy(VT5, S5);
    }           
    :VD5".qf16 = vmpy("VT5".hf,"S5".hf)" is imm_21_27=0b1010000 & S5 & imm_13=1 & VT5 & imm_5_7=0b011 & VD5 {
        VD5 = HVX_mpy(VT5, S5);
    }
}

# Floating point multiply - single precision
with slot: iclass=0b0001 {
    :VD5".qf32 = vmpy("VT5".qf32,"VS5".qf32)" is imm_21_27=0b1111111 & VS5 & imm_13=1 & VT5 & imm_5_7=0b000 & VD5 {
        VD5 = HVX_mpy(VT5, VS5);
    }     
    # (v79)  
    :VD5".qf32 = vmpy("VT5".sf,"VS5".sf)" is imm_21_27=0b1111111 & VS5 & imm_13=1 & VT5 & imm_5_7=0b001 & VD5 {
        VD5 = HVX_mpy(VT5, VS5);
    }       
    :VD5".qf32 = vmpy("VT5".sf,"S5".sf)" is imm_21_27=0b1010000 & S5 & imm_13=1 & VT5 & imm_5_7=0b001 & VD5 {
        VD5 = HVX_mpy(VT5, S5);
    }       
}

# Multiply 32x16
with slot: iclass=0b0001 {
	:VD5_pair" += vmpyo("VT5".w,"VS5".h)" is imm_21_27=0b1100001 & VS5 & imm_13=1 & VT5 & imm_5_7=0b011 & VD5_pair {
        VD5_pair = HVX_mpyo_acc(VD5_pair, VT5, VS5);
    }    
    :VD5".w += vmpyo("VT5".w,"VS5".h):<<1:sat:shift" is imm_21_27=0b1100001 & VS5 & imm_13=1 & VT5 & imm_5_7=0b110 & VD5 {
        VD5 = HVX_mpyo_acc_lsl_sat_shift(VD5, VT5, VS5);
    }    
    :VD5".w += vmpyo("VT5".w,"VS5".h):<<1:rnd:sat:shift" is imm_21_27=0b1100001 & VS5 & imm_13=1 & VT5 & imm_5_7=0b111 & VD5 {
        VD5 = HVX_mpyo_acc_lsl_rnd_sat_shift(VD5, VT5, VS5);
    }   
    
    :VD5_pair" = vmpye("VT5".w,"VS5".uh)" is imm_21_27=0b1110101 & VS5 & imm_13=0 & VT5 & imm_5_7=0b110 & VD5_pair {
        VD5_pair = HVX_mpye(VT5, VS5);
    }  
    :VD5".w = vmpyo("VT5".w,"VS5".h):<<1:rnd:sat" is imm_21_27=0b1111010 & VS5 & imm_13=0 & VT5 & imm_5_7=0b000 & VD5 {
        VD5 = HVX_mpyo_sat_lsl_rnd_sat(VT5, VS5);
    }  
    :VD5".w = vmpye("VT5".w,"VS5".uh)" is imm_21_27=0b1111111 & VS5 & imm_13=0 & VT5 & imm_5_7=0b101 & VD5 {
        VD5 = HVX_mpye(VT5, VS5);
    }  
    :VD5".w = vmpyo("VT5".w,"VS5".h):<<1:sat" is imm_21_27=0b1111111 & VS5 & imm_13=0 & VT5 & imm_5_7=0b111 & VD5 {
        VD5 = HVX_mpyo_lsl_sat(VT5, VS5);
    }  
    
    # (v85)
    :VD5".w = vmpye("VT5".w,"VS5".uh):rnd" is imm_21_27=0b1001100 & VS5 & imm_13=0 & VT5 & imm_5_7=0b100 & VD5 {
        VD5 = HVX_mpye_rnd(VT5, VS5);
    } 
    # (v85)
    :VD5".w = vmpyo("VT5".w,"VS5".uh)" is imm_21_27=0b1100010 & VS5 & imm_13=1 & VT5 & imm_5_7=0b110 & VD5 {
        VD5 = HVX_mpyo(VT5, VS5);
    } 
    # (v85)
    :VD5".w = vmpyo("VT5".w,"VS5".uh):rnd" is imm_21_27=0b1101000 & VS5 & imm_13=0 & VT5 & imm_5_7=0b100 & VD5 {
        VD5 = HVX_mpyo_rnd(VT5, VS5);
    } 
    # (v85)
    :VD5".w += vmpyo("VT5".w,"VS5".uh)" is imm_21_27=0b1100010 & VS5 & imm_13=1 & VT5 & imm_5_7=0b111 & VD5 {
        VD5 = HVX_mpyo_acc(VD5, VT5, VS5);
    } 
    # (v85)
    :VD5".w += vmpyo("VT5".w,"VS5".uh):rnd" is imm_21_27=0b1101000 & VS5 & imm_13=0 & VT5 & imm_5_7=0b101 & VD5 {
        VD5 = HVX_mpyo_acc_rnd(VD5, VT5, VS5);
    } 
}

# Multiply bytes with 4-wide reduction
with slot: iclass=0b0001 {
	:VD5_pair".w = vrmpy("VT5_pair".ub,"VS5_pair".b,"imm_5u")" is imm_21_27=0b1001010 & VS5_pair & imm_13=0 & VT5_pair & imm_6_7=0b10 & imm_5u & VD5_pair {
        VD5_pair = HVX_rmpy(VT5_pair, VS5_pair, imm_5u);
    }
    
    :VD5_pair".w += vrmpy("VT5_pair".ub,"VS5_pair".b,"imm_5u")" is imm_21_27=0b1001010 & VS5_pair & imm_13=1 & VT5_pair & imm_6_7=0b10 & imm_5u & VD5_pair {
        VD5_pair = HVX_rmpy_acc(VD5_pair, VT5_pair, VS5_pair, imm_5u);
    }
    :VD5_pair".uw += vrmpy("VT5_pair".ub,"S5".ub,"imm_5u")" is imm_21_27=0b1001011 & S5 & imm_13=1 & VT5_pair & imm_6_7=0b11 & imm_5u & VD5_pair {
        VD5_pair = HVX_rmpy_acc(VD5_pair, VT5_pair, S5, imm_5u);
    }
    
    :VD5_pair".uw += vrmpy("VT5_pair".ub,"S5".ub,"imm_5u")" is imm_21_27=0b1001101 & S5 & imm_13=0 & VT5_pair & imm_6_7=0b11 & imm_5u & VD5_pair {
        VD5_pair = HVX_rmpy_acc(VD5_pair, VT5_pair, S5, imm_5u);
    }
}

