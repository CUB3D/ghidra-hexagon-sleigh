	}
}

# Unpack
with slot: iclass=0b0001 {
	:VD5_pair".uh = vunpack("VT5".ub)" is imm_24_27=0b1110 & imm_22_23=0 & imm_21=0 & imm_18_20=0 & imm_16_17=0b01 & imm_13=0 & VT5 & imm_5_7=0b000 & VD5_pair {
