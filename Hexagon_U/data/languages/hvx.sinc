# Vector Scatter
with slot: iclass=0b0010 {
	:"vscatter("S5","M1_13","VT5_pair".w).h="VD5 is imm_21_27=0b1111001 & S5 & M1_13 & VT5_pair & imm_5_7=0b010 & VD5 {
