with slot: iclass=0b0001 {
    :VD5".uw += vrmpy("VT5".ub,"VS5".ub)" is imm_21_27=0b1100000 & VS5 & imm_13=1 & VT5 & imm_5_7=0b000 & VD5 {
        VD5 = HVX_rmpy_acc(VD5, VT5, VS5);
    }        
    :VD5".w += vrmpy("VT5".b,"VS5".b)" is imm_21_27=0b1100000 & VS5 & imm_13=1 & VT5 & imm_5_7=0b001 & VD5 {
        VD5 = HVX_rmpy_acc(VD5, VT5, VS5);
    }  
    :VD5".w += vrmpy("VT5".ub,"VS5".b)" is imm_21_27=0b1100000 & VS5 & imm_13=1 & VT5 & imm_5_7=0b010 & VD5 {
        VD5 = HVX_rmpy_acc(VD5, VT5, VS5);
    }              
}

# Multiply with 3-wide reduction
with slot: iclass=0b0001 {
	:VD5_pair".h = vtmpy("VT5_pair".b,"S5".b)" is imm_21_27=0b1001000 & S5 & imm_13=0 & VT5_pair & imm_5_7=0b000 & VD5_pair {
        VD5_pair = HVX_tmpy(VT5_pair, S5);
    }
    :VD5_pair".h = vtmpy("VT5_pair".ub,"S5".b)" is imm_21_27=0b1001000 & S5 & imm_13=0 & VT5_pair & imm_5_7=0b001 & VD5_pair {
        VD5_pair = HVX_tmpy(VT5_pair, S5);
    }
    
    :VD5_pair".h += vtmpy("VT5_pair".b,"S5".b)" is imm_21_27=0b1001000 & S5 & imm_13=1 & VT5_pair & imm_5_7=0b000 & VD5_pair {
        VD5_pair = HVX_tmpy_acc(VD5_pair, VT5_pair, S5);
    }
