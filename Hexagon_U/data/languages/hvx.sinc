	:VD5_pair".h |= vunpacko("VT5".b)" is imm_24_27=0b1110 & imm_22_23=0 & imm_21=0 & imm_19_20=0 & imm_16_18=0b000 & imm_13=1 & VT5 & imm_5_7=0b000 & VD5_pair {
