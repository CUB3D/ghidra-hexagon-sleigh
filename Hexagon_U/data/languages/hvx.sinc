}

# Vector shuffle and deal cross lane
with slot: iclass=0b0001 {
	:"vshuff("VT5","VD5","S5")" is imm_21_27=0b1001111 & S5 & imm_13=1 & VT5 & imm_5_7=0b001 & VD5 {
