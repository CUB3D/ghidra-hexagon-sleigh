	}
	:VD5_pair".w |= vunpacko("VT5".h)" is imm_24_27=0b1110 & imm_22_23=0 & imm_21=0 & imm_19_20=0 & imm_16_18=0b000 & imm_13=1 & VT5 & imm_5_7=0b001 & VD5_pair {
		VD5_pair = HVX_unpacko_or(VD5_pair, VT5);
	}
}

# HVX/HVX SCATTER DOUBLE RESOURCE

define pcodeop vscatter_w;
define pcodeop vscatter_h;
define pcodeop vscatter_wp;
