	:"if("Qs4_5_6_pred") vscatter("S5","M1_13","VT5_pair".w).h="VD5 is imm_21_27=0b1111101 & S5 & M1_13 & VT5_pair & imm_7=0 & Qs4_5_6_pred & VD5 {
		HVX_cond_scatter(Qs4_5_6_pred, S5, M1_13, VT5_pair, VD5);
	}
}

