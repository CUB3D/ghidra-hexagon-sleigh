# Hexagon HLX starts from V85

define register offset=0x10000 size=2048 [
	L0 L1 L2 L3 L4 L5 L6 L7 L8 L9 L10 L11 L12 L13 L14 L15
];

define register offset=0x10000 size=4096 [
	L1L0 L3L2 L5L4 L7L6 L9L8 L11L10 L13L12 L15L14
];

attach variables [ LDV LD16 LUV LVV LXV LXV_dup ] [
	L0 L1 L2 L3 L4 L5 L6 L7 L8 L9 L10 L11 L12 L13 L14 L15
];

attach variables [ LDDV LUUV LVVV LXXV LXXV_dup ] [
	L1L0 L3L2 L5L4 L7L6 L9L8 L11L10 L13L12 L15L14
];

define pcodeop HLX_abs;
define pcodeop HLX_abs_sat;

# HLX/ALUCOMMON

# HLX/ALUCOMMON - Halfword absolute value
with slot: iclass=0b1110 {
    :LDV".uh = abs("LUV".h)" is imm_21_27=0b0101000 & imm_16_18=0b001 & imm_10_13=0b1010 & LUV & imm_5=1 & LDV & imm_0=0 {
        LDV = HLX_abs(LUV);
    }
    :LDV".h = abs("LUV".h):sat" is imm_21_27=0b0101000 & imm_16_18=0b001 & imm_10_13=0b1010 & LUV & imm_5=1 & LDV & imm_0=1 {
        LDV = HLX_abs_sat(LUV);
    }
}

# HLX/ALUCOMMON - Halfword and word add/subtract
with slot: iclass=0b1110 {
    :LDDV".w = add("LUUV".w,"LVV".h)" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1111 & LUUV & imm_5=1 & LDDV & imm_0=0 {
        LDDV = HLX_add(LUUV, LUV);
    }
    :LDDV".w = add("LUUV".w,"LVV".uh)" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1111 & LUUV & imm_5=1 & LDDV & imm_0=1 {
        LDDV = HLX_add(LUUV, LVV);
    }
    :LDDV".w = sub("LUUV".w,"LVV".h)" is imm_21_27=0b0101001 & LVV & imm_10_13=0b1000 & LUUV & imm_5=0 & LDDV & imm_0=0 {
        LDDV = HLX_sub(LUUV, LVV);
    }
    :LDDV".w = sub("LUUV".w,"LVV".uh)" is imm_21_27=0b0101001 & LVV & imm_10_13=0b1000 & LUUV & imm_5=0 & LDDV & imm_0=1 {
        LDDV = HLX_sub(LUUV, LVV);
    }
}

# HLX/ALUCOMMON - Halfword widening add/subtract
with slot: iclass=0b1110 {
    :LDDV".w = add("LUV".uh,"LVV".uh)" is imm_21_27=0b0101001 & LVV & imm_10_13=0b1010 & LUV & imm_5=0 & LDDV & imm_0=0 {
        LDDV = HLX_add(LUV, LVV);
    }
    :LDDV".w = sub("LUV".uh,"LVV".uh)" is imm_21_27=0b0101001 & LVV & imm_10_13=0b1010 & LUV & imm_5=0 & LDDV & imm_0=1 {
        LDDV = HLX_sub(LUV, LVV);
    }
}

# HLX/ALUCOMMON - Halfword add/subtract
with slot: iclass=0b1110 {
    :LDV".h = add("LUV".h,"LVV".h)" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1011 & LUV & imm_5=0 & LDV & imm_0=0 {
        LDV = HLX_add(LUV, LVV);
    }
    :LDV".h = add("LUV".h,"LVV".h):sat" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1011 & LUV & imm_5=0 & LDV & imm_0=1 {
        LDV = HLX_add_sat(LUV, LVV);
    }
    :LDV".uh = add("LUV".uh,"LVV".uh):sat" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1011 & LUV & imm_5=1 & LDV & imm_0=0 {
        LDV = HLX_add_sat(LUV, LVV);
    }
    :LDV".uh = add("LUV".h,"LVV".h):sat" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1011 & LUV & imm_5=1 & LDV & imm_0=1 {
        LDV = HLX_add_sat(LUV, LVV);
    }
    :LDV".h = sub("LUV".h,"LVV".h)" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1100 & LUV & imm_5=0 & LDV & imm_0=0 {
        LDV = HLX_sub(LUV, LVV);
    }
    # The spec is wrong here "LdV.uh[i] = ..", qcom pls fix
    :LDV".h = sub("LUV".h,"LVV".h):sat" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1100 & LUV & imm_5=0 & LDV & imm_0=1 {
        LDV = HLX_sub_sat(LUV, LVV);
    }
    :LDV".uh = sub("LUV".uh,"LVV".uh):sat" is imm_21_27=0b0101001 & LVV & imm_10_13=0b1111 & LUV & imm_5=0 & LDV & imm_0=0 {
        LDV = HLX_sub_sat(LUV, LVV);
    }
    :LDV".uh = sub("LUV".h,"LVV".h):sat" is imm_21_27=0b0101001 & LVV & imm_10_13=0b1111 & LUV & imm_5=1 & LDV & imm_0=1 {
        LDV = HLX_sub_sat(LUV, LVV);
    }
}

# HLX/ALUCOMMON - Assign
with slot: iclass=0b1110 {
    :LDV".h = "LUV".h" is imm_21_27=0b0101000 & imm_10_13=0b1110 & LUV & imm_5=1 & LDV & imm_0=0 {
        LDV = HLX_copy(LUV);
    }
    :LDDV".w = "LUUV".w" is imm_21_27=0b0101000 & imm_10_13=0b1110 & LUUV & imm_5=1 & LDDV & imm_0=1 {
        LDDV = HLX_copy(LUUV);
    }
}

# HLX/ALUCOMMON - Halfword Compare
with slot: iclass=0b1110 {
    :LDV".h = cmp.gt("LUV".uh,"LVV".uh)" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1000 & LUV & imm_5=1 & LDV & imm_0=0 {
        LDV = HLX_cmp_gt(LUV, LVV);
    }
    :LDV".h = cmp.gt("LUV".h,"LVV".h)" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1000 & LUV & imm_5=0 & LDV & imm_0=1 {
        LDV = HLX_cmp_gt(LUV, LVV);
    }
}

# HLX/ALUCOMMON - Halfword to word convert
with slot: iclass=0b1110 {
    :LDDV".uw = zxt("LUV".uh)" is imm_21_27=0b0101000 & imm_16_18=0b001 & imm_10_13=0b1010 & LUV & imm_5=0 & LDDV & imm_0=0 {
        LDDV = HLX_zxt(LUV);
    }
    :LDDV".w = sxt("LUV".h)" is imm_21_27=0b0101000 & imm_16_18=0b001 & imm_10_13=0b1010 & LUV & imm_5=0 & LDDV & imm_0=1 {
        LDDV = HLX_sxt(LUV);
    }
}

# HLX/ALUCOMMON - Logical
with slot: iclass=0b1110 {
    :LDV" = and("LUV","LVV")" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1101 & LUV & imm_5=0 & LDV & imm_0=0 {
        LDV = HLX_and(LUV);
    }
    :LDV" = or("LUV","LVV")" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1110 & LUV & imm_5=0 & LDV & imm_0=0 {
        LDV = HLX_or(LUV);
    }
    :LDV" = xor("LUV","LVV")" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1101 & LUV & imm_5=1 & LDV & imm_0=1 {
        LDV = HLX_xor(LUV);
    }
    :LDV" = not("LUV")" is imm_21_27=0b0101000 & imm_10_13=0b1101 & LUV & imm_5=1 & LDV & imm_0=0 {
        LDV = HLX_not(LUV);
    }
    :LDV" = andn("LUV","LVV")" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1101 & LUV & imm_5=0 & LDV & imm_0=1 {
        LDV = HLX_andn(LUV);
    }
    :LDV" = orn("LUV","LVV")" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1110 & LUV & imm_5=0 & LDV & imm_0=1 {
        LDV = HLX_orn(LUV);
    }
}

# HLX/ALUCOMMON - Halfword min max
with slot: iclass=0b1110 {
    :LDV".uh = max("LUV".uh,"LVV".uh)" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1001 & LUV & imm_5=1 & LDV & imm_0=0 {
        LDV = HLX_max(LUV, LVV);
    }
    :LDV".uh = min("LUV".uh,"LVV".uh)" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1001 & LUV & imm_5=1 & LDV & imm_0=1 {
        LDV = HLX_min(LUV, LVV);
    }
    :LDV".h = max("LUV".h,"LVV".h)" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1001 & LUV & imm_5=0 & LDV & imm_0=0 {
        LDV = HLX_max(LUV, LVV);
    }
    :LDV".h = min("LUV".h,"LVV".h)" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1001 & LUV & imm_5=0 & LDV & imm_0=1 {
        LDV = HLX_min(LUV, LVV);
    }
}

# HLX/ALUCOMMON - Mux select
with slot: iclass=0b1110 {
    :LXV".h = mux("LXV_dup".h,"LUV".h,"LVV".h)" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1000 & LUV & imm_5=0 & LXV & LXV_dup & imm_0=0 {
        LXV = HLX_mux(LXV, LUV, LVV);
    }
}

# HLX/ALUCOMMON - Splat
with slot: iclass=0b1110 {
    :LDV".h = "S5".h" is imm_21_27=0b0101001 & S5 & imm_10_13=0b1001 & imm_5=1 & LDV & imm_0=0 {
        LDV = HLX_copy(S5);
    }
    :LDV".h = "imm_16_20 is imm_21_27=0b0101001 & imm_16_20 & imm_10_13=0b1010 & imm_5=1 & LDV & imm_0=1 {
        LDV = HLX_copy(imm_16_20:4);
    }
    :LDV".uh = "imm_16_20u is imm_21_27=0b0101001 & imm_16_20u & imm_10_13=0b1010 & imm_5=1 & LDV & imm_0=0 {
        LDV = HLX_copy(imm_16_20u:4);
    }
    :LDDV".w = "S5".w" is imm_21_27=0b0101001 & S5 & imm_10_13=0b1001 & imm_5=1 & LDDV & imm_0=1 {
        LDDV = HLX_copy(S5);
    }
}


# HLX/EXTENDEDALU

# HLX/EXTENDEDALU - Absolute value of difference
with slot: iclass=0b1110 {
    :LDV".uh = absdiff("LUV".h,"LVV".h)" is imm_21_27=0b1101000 & LVV & imm_10_13=0b1001 & LUV & imm_5=0 & LDV & imm_0=0 {
        LDV = HLX_absdiff(LUV, LVV);
    }
    :LDV".uh = absdiff("LUV".uh,"LVV".uh)" is imm_21_27=0b1101000 & LVV & imm_10_13=0b1001 & LUV & imm_5=1 & LDV & imm_0=0 {
        LDV = HLX_absdiff(LUV, LVV);
    }
    :LDDV".uw = absdiff("LUUV".w,"LVVV".w)" is imm_21_27=0b1101000 & LVVV & imm_10_13=0b1001 & LUUV & imm_5=0 & LDDV & imm_0=1 {
        LDDV = HLX_absdiff(LUUV, LVVV);
    }
    :LDDV".uw = absdiff("LUUV".uw,"LVVV".uw)" is imm_21_27=0b1101000 & LVVV & imm_10_13=0b1001 & LUUV & imm_5=1 & LDDV & imm_0=1 {
        LDDV = HLX_absdiff(LUUV, LVVV);
    }
}

# HLX/EXTENDEDALU - Average
with slot: iclass=0b1110 {
    :LDV".h = avg("LUV".h,"LVV".h)" is imm_21_27=0b1101000 & LVV & imm_10_13=0b1010 & LUV & imm_5=0 & LDV & imm_0=0 {
        LDV = HLX_avg(LUV, LVV);
    }
    :LDV".h = avg("LUV".h,"LVV".h):rnd" is imm_21_27=0b1101000 & LVV & imm_10_13=0b1011 & LUV & imm_5=0 & LDV & imm_0=0 {
        LDV = HLX_avg_rnd(LUV, LVV);
    }
    :LDDV".w = avg("LUUV".w,"LVVV".w)" is imm_21_27=0b1101000 & LVVV & imm_10_13=0b1010 & LUUV & imm_5=0 & LDDV & imm_0=1 {
        LDDV = HLX_avg(LUUV, LVVV);
    }
    :LDDV".w = avg("LUUV".w,"LVVV".w):rnd" is imm_21_27=0b1101000 & LVVV & imm_10_13=0b1011 & LUUV & imm_5=0 & LDDV & imm_0=1 {
        LDDV = HLX_avg_rnd(LUUV, LVVV);
    }
    :LDV".uh = avg("LUV".uh,"LVV".uh)" is imm_21_27=0b1101000 & LVV & imm_10_13=0b1010 & LUV & imm_5=1 & LDV & imm_0=0 {
        LDV = HLX_avg(LUV, LVV);
    }
    :LDV".uh = avg("LUV".uh,"LVV".uh):rnd" is imm_21_27=0b1101000 & LVV & imm_10_13=0b1011 & LUV & imm_5=1 & LDV & imm_0=0 {
        LDV = HLX_avg_rnd(LUV, LVV);
    }
    :LDDV".uw = avg("LUUV".uw,"LVVV".uw)" is imm_21_27=0b1101000 & LVVV & imm_10_13=0b1010 & LUUV & imm_5=1 & LDDV & imm_0=1 {
        LDDV = HLX_avg(LUUV, LVVV);
    }
    :LDDV".uw = avg("LUUV".uw,"LVVV".uw):rnd" is imm_21_27=0b1101000 & LVVV & imm_10_13=0b1011 & LUUV & imm_5=1 & LDDV & imm_0=1 {
        LDDV = HLX_avg_rnd(LUUV, LVVV);
    }
}

# HLX/EXTENDEDALU - Byte convert
with slot: iclass=0b1110 {
    :LDV".b = packhi("LUV".h,"LVV".h)" is imm_21_27=0b1101000 & LVV & imm_10_13=0b1101 & LUV & imm_5=0 & LDV & imm_0=1 {
        LDV = HLX_packhi(LUV, LVV);
    }
    :LDV".b = packlo("LUV".h,"LVV".h)" is imm_21_27=0b1101000 & LVV & imm_10_13=0b1101 & LUV & imm_5=0 & LDV & imm_0=0 {
        LDV = HLX_packlo(LUV, LVV);
    }
    :LDDV".h = unpackhi("LUV".b)" is imm_21_27=0b1101000 & imm_10_13=0b1101 & LUV & imm_5=1 & LDDV & imm_0=1 {
        LDDV = HLX_unpackhi(LUV);
    }
    :LDDV".h = unpacklo("LUV".b)" is imm_21_27=0b1101000 & imm_10_13=0b1101 & LUV & imm_5=1 & LDDV & imm_0=0 {
        LDDV = HLX_unpacklo(LUV);
    }
}

# HLX/EXTENDEDALU - Bit Count
with slot: iclass=0b1110 {
    :LDV".h = sub(ilog2("LUV".h), "imm_17_20u")" is imm_21_27=0b1101001 & imm_17_20u & imm_10_13=0b1001 & LUV & imm_5=0 & LDV & imm_0=0 {
        LDV = HLX_sub_ilog2(LUV, imm_17_20u:4);
    }
    :LDV".h = sub(ilog2("LUV".uh), "imm_17_20u")" is imm_21_27=0b1101001 & imm_17_20u & imm_10_13=0b1001 & LUV & imm_5=0 & LDV & imm_0=1 {
        LDV = HLX_sub_ilog2(LUV, imm_17_20u:4);
    }
    :LDV".h = sub(ilog2("LUUV".w), "imm_16_20u")" is imm_21_27=0b1101001 & imm_16_20u & imm_10_13=0b1001 & LUUV & imm_5=1 & LDV & imm_0=0 {
        LDV = HLX_sub_ilog2(LUUV, imm_17_20u:4);
    }
    :LDV".h = sub(ilog2("LUUV".uw), "imm_16_20u")" is imm_21_27=0b1101001 & imm_16_20u & imm_10_13=0b1001 & LUUV & imm_5=1 & LDV & imm_0=1 {
        LDV = HLX_sub_ilog2(LUUV, imm_17_20u:4);
    }
}

# HLX/EXTENDEDALU - Lookup table
with slot: iclass=0b1110 {
    :LDV".h = lut4("LUV".uh,"S5_pair".h)" is imm_21_27=0b1101000 & S5_pair & imm_10_13=0b1000 & LUV & imm_5=0 & LDV & imm_0=0 {
        LDV = HLX_lut4(LUV, S5_pair);
    }
    :LDDV".w = lut4("LUV".uh,"S5_pair".uh):>>1" is imm_21_27=0b1101000 & S5_pair & imm_10_13=0b1000 & LUV & imm_5=0 & LDDV & imm_0=1 {
        LDDV = HLX_lut4_shift(LUV, S5_pair);
    }
    :LDDV".w = lut4("LUV".uh,"S5_pair".uh):>>1:neg" is imm_21_27=0b1101000 & S5_pair & imm_10_13=0b1000 & LUV & imm_5=1 & LDDV & imm_0=0 {
        LDDV = HLX_lut4_shift_neg(LUV, S5_pair);
    }
    :LDV".h = lut4("LUV".uh,"S5_pair".h):mask" is imm_21_27=0b1101000 & S5_pair & imm_10_13=0b1000 & LUV & imm_5=1 & LDV & imm_0=1 {
        LDV = HLX_lut4_mask(LUV, S5_pair);
    }
}

# HLX/EXTENDEDALU - Negative Average
with slot: iclass=0b1110 {
    :LDV".h = navg("LUV".h,"LVV".h)" is imm_21_27=0b1101000 & LVV & imm_10_13=0b1100 & LUV & imm_5=0 & LDV & imm_0=0 {
        LDV = HLX_mavg(LUV, LVV);
    }
    :LDDV".w = navg("LUUV".w,"LVVV".w)" is imm_21_27=0b1101000 & LVVV & imm_10_13=0b1100 & LUUV & imm_5=0 & LDDV & imm_0=1 {
        LDDV = HLX_mavg(LUUV, LVVV);
    }
    :LDV".h = navg("LUV".uh,"LVV".uh)" is imm_21_27=0b1101000 & LVV & imm_10_13=0b1100 & LUV & imm_5=1 & LDV & imm_0=0 {
        LDV = HLX_mavg(LUV, LVV);
    }
    :LDDV".w = navg("LUUV".uw,"LVVV".uw)" is imm_21_27=0b1101000 & LVVV & imm_10_13=0b1100 & LUUV & imm_5=1 & LDDV & imm_0=1 {
        LDDV = HLX_mavg(LUUV, LVVV);
    }
}

# HLX/LOAD

# HLX/LOAD - Tmp
with slot: iclass=0b1001 {
    :LD16".tmp = mem("S5")" is imm_24_27=0b1000 & S5 & imm_11_12=0b10 & imm_4_6u=0b000 & LD16 {
        LD16 = HLX_load(S5);
    }
    :"if ("T2_9_10_pred") "LD16".tmp = mem("S5")" is imm_24_27=0b1000 & S5 &  imm_11_12=0b10 & T2_9_10_pred & imm_4_6u=0b100 & LD16 {
        LD16 = HLX_cond_load(T2_9_10_pred, LD16, S5);
    }
}

# HLX/MPY

# HLX/MPY - Multiply add with high or low
with slot: iclass=0b1110 {
    :LXXV".uw = add(mpy("LUV".uh,"S5".uh),lo("LXXV_dup").uh)" is imm_21_27=0b0111000 & S5 & imm_10_13=0b1011 & LUV & imm_5=0 & LXXV & LXXV_dup & imm_0=0 {
        LXXV = HLX_add_mpy_lo(LUV, S5, LXXV_dup);
    }
    :LXXV".uw = add(mpy("LUV".uh,"LVV".uh),lo("LXXV_dup").uh)" is imm_21_27=0b0111000 & LVV & imm_10_13=0b1011 & LUV & imm_5=0 & LXXV & LXXV_dup & imm_0=1 {
        LXXV = HLX_add_mpy_lo(LUV, LVV, LXXV_dup);
    }
    :LXXV".w = add(mpy("LUV".h,"S5".uh),lo("LXXV_dup").uh)" is imm_21_27=0b0111000 & S5 & imm_10_13=0b1011 & LUV & imm_5=1 & LXXV & LXXV_dup & imm_0=0 {
        LXXV = HLX_add_mpy_lo(LUV, S5, LXXV_dup);
    }
    :LXXV".w = add(mpy("LUV".h,"LVV".uh),lo("LXXV_dup").uh)" is imm_21_27=0b0111000 & LVV & imm_10_13=0b1011 & LUV & imm_5=1 & LXXV & LXXV_dup & imm_0=1 {
        LXXV = HLX_add_mpy_lo(LUV, LVV, LXXV_dup);
    }
    :LXXV".uw = add(mpy("LUV".uh,"S5".uh),hi("LXXV_dup").uh)" is imm_21_27=0b0111000 & S5 & imm_10_13=0b1100 & LUV & imm_5=0 & LXXV & LXXV_dup & imm_0=0 {
        LXXV = HLX_add_mpy_hi(LUV, S5, LXXV_dup);
    }
    :LXXV".uw = add(mpy("LUV".uh,"LVV".uh),hi("LXXV_dup").uh)" is imm_21_27=0b0111000 & LVV & imm_10_13=0b1100 & LUV & imm_5=0 & LXXV & LXXV_dup & imm_0=1 {
        LXXV = HLX_add_mpy_hi(LUV, LVV, LXXV_dup);
    }
    :LXXV".uw = add(mpy("LUV".h,"S5".uh),hi("LXXV_dup").uh)" is imm_21_27=0b0111000 & S5 & imm_10_13=0b1100 & LUV & imm_5=1 & LXXV & LXXV_dup & imm_0=0 {
        LXXV = HLX_add_mpy_hi(LUV, S5, LXXV_dup);
    }
    :LXXV".uw = add(mpy("LUV".h,"LVV".uh),hi("LXXV_dup").uh)" is imm_21_27=0b0111000 & LVV & imm_10_13=0b1100 & LUV & imm_5=1 & LXXV & LXXV_dup & imm_0=1 {
        LXXV = HLX_add_mpy_hi(LUV, LVV, LXXV_dup);
    }
    :LXXV".uw = add(mpy("LUV".uh,hi("LXXV_dup").uh),"S5".w)" is imm_21_27=0b0111111 & S5 & imm_10_13=0b1101 & LUV & imm_5=0 & LXXV & LXXV_dup & imm_0=0 {
        LXXV = HLX_add_mpy_hi(LUV, LXXV_dup, S5);
    }
    :LXXV".uw = add(mpy("LUV".uh,hi("LXXV_dup").uh),"LVVV".w)" is imm_21_27=0b0111111 & LVVV & imm_10_13=0b1101 & LUV & imm_5=0 & LXXV & LXXV_dup & imm_0=1 {
        LXXV = HLX_add_mpy_hi(LUV, LXXV_dup, LVVV);
    }
    :LXXV".w = add(mpy("LUV".uh,hi("LXXV_dup").h),"S5".w)" is imm_21_27=0b0111111 & S5 & imm_10_13=0b1101 & LUV & imm_5=1 & LXXV & LXXV_dup & imm_0=0 {
        LXXV = HLX_add_mpy_hi(LUV, LXXV_dup, S5);
