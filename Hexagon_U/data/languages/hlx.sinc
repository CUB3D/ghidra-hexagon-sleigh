with slot: iclass=0b1110 {
    :LDV".uh = abs("LUV".h)" is imm_21_27=0b0101000 & imm_16_18=0b001 & imm_10_13=0b1010 & LUV & imm_5=1 & LDV & imm_0=0 {
        _hlx_stub();
