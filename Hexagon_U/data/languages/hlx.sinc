# Hexagon HLX starts from V85

define register offset=0x10000 size=2048 [
	L0 L1 L2 L3 L4 L5 L6 L7 L8 L9 L10 L11 L12 L13 L14 L15
];

define register offset=0x10000 size=4096 [
	L1L0 L3L2 L5L4 L7L6 L9L8 L11L10 L13L12 L15L14
];

attach variables [ LDV LUV LVV LXV LXV_dup ] [
	L0 L1 L2 L3 L4 L5 L6 L7 L8 L9 L10 L11 L12 L13 L14 L15
];

attach variables [ LDDV LUUV LVVV ] [
	L1L0 L3L2 L5L4 L7L6 L9L8 L11L10 L13L12 L15L14
];

define pcodeop _hlx_stub;

# HLX/ALUCOMMON

# HLX/ALUCOMMON - Halfword absolute value
with slot: iclass=0b1110 {
    :LDV".uh = abs("LUV".h)" is imm_21_27=0b0101000 & imm_16_18=0b001 & imm_10_13=0b1010 & imm_5=1 & imm_0=0 & LUV & LDV {
        _hlx_stub();
    }
    :LDV".h = abs("LUV".h):sat" is imm_21_27=0b0101000 & imm_16_18=0b001 & imm_10_13=0b1010 & imm_5=1 & imm_0=1 & LUV & LDV {
        _hlx_stub();
    }
}

# HLX/ALUCOMMON - Halfword and word add/subtract
with slot: iclass=0b1110 {
    :LDDV".w = add("LUUV".w,"LVV".h)" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1111 & imm_5=1 & imm_0=0 & LUUV & LDDV {
        _hlx_stub();
    }
    :LDDV".w = add("LUUV".w,"LVV".uh)" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1111 & imm_5=1 & imm_0=1 & LUUV & LDDV {
        _hlx_stub();
    }
    :LDDV".w = sub("LUUV".w,"LVV".h)" is imm_21_27=0b0101001 & LVV & imm_10_13=0b1000 & imm_5=0 & imm_0=0 & LUUV & LDDV {
        _hlx_stub();
    }
    :LDDV".w = sub("LUUV".w,"LVV".uh)" is imm_21_27=0b0101001 & LVV & imm_10_13=0b1000 & imm_5=0 & imm_0=1 & LUUV & LDDV {
        _hlx_stub();
    }
}

# HLX/ALUCOMMON - Halfword widening add/subtract
with slot: iclass=0b1110 {
    :LDDV".w = add("LUV".uh,"LVV".uh)" is imm_21_27=0b0101001 & LVV & imm_10_13=0b1010 & imm_5=0 & imm_0=0 & LUV & LDDV {
        _hlx_stub();
    }
    :LDDV".w = sub("LUV".uh,"LVV".uh)" is imm_21_27=0b0101001 & LVV & imm_10_13=0b1010 & imm_5=0 & imm_0=1 & LUV & LDDV {
        _hlx_stub();
    }
}

# HLX/ALUCOMMON - Halfword add/subtract
with slot: iclass=0b1110 {
    :LDV".h = add("LUV".h,"LVV".h)" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1011 & imm_5=0 & imm_0=0 & LUV & LDV {
        _hlx_stub();
    }
    :LDV".h = add("LUV".h,"LVV".h):sat" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1011 & imm_5=0 & imm_0=1 & LUV & LDV {
        _hlx_stub();
    }
    :LDV".uh = add("LUV".uh,"LVV".uh):sat" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1011 & imm_5=1 & imm_0=0 & LUV & LDV {
        _hlx_stub();
    }
    :LDV".uh = add("LUV".h,"LVV".h):sat" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1011 & imm_5=1 & imm_0=1 & LUV & LDV {
        _hlx_stub();
    }
    :LDV".h = sub("LUV".h,"LVV".h)" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1100 & imm_5=0 & imm_0=0 & LUV & LDV {
        _hlx_stub();
    }
    # The spec is wrong here "LdV.uh[i] = ..", qcom pls fix
    :LDV".h = sub("LUV".h,"LVV".h):sat" is imm_21_27=0b0101000 & LVV & imm_10_13=0b1100 & imm_5=0 & imm_0=1 & LUV & LDV {
        _hlx_stub();
    }
    :LDV".uh = sub("LUV".uh,"LVV".uh):sat" is imm_21_27=0b0101001 & LVV & imm_10_13=0b1111 & imm_5=0 & imm_0=0 & LUV & LDV {
        _hlx_stub();
    }
    :LDV".uh = sub("LUV".h,"LVV".h):sat" is imm_21_27=0b0101001 & LVV & imm_10_13=0b1111 & imm_5=1 & imm_0=1 & LUV & LDV {
        _hlx_stub();
    }
}

